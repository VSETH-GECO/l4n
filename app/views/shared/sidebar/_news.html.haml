.card.mb-3
  .card-header.sidebar-header
    = _('Sidebar|Latest newsposts')
    = link_to news_index_path, class: 'sidebar-view-all' do
      = _('Sidebar|All newsposts')
      = icon %i[fas fa-arrow-right]
  .card-body
    %ul.sidebar-list
      - news_posts.each do |news_post|
        %li
          = link_to news_path(news_post), class: 'sidebar-list-item' do
            .sidebar-list-item-text
              .sidebar-list-item-title= news_post.title
              .sidebar-list-item-meta= l(news_post.published_at, format: '%d. %b %Y')

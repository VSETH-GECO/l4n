.card.mb-3
  .card-header.sidebar-header
    = _('Sidebar|Next events')
    = link_to events_path, class: 'sidebar-view-all' do
      = _('Sidebar|All events')
      = icon %i[fas fa-arrow-right]
  .card-body
    %ul.sidebar-list
      - events.each do |event|
        - date = event.next_date
        %li
          = link_to event, class: 'sidebar-list-item' do
            .sidebar-date-tile
              .sidebar-date-tile-day= l(date.start_date, format: '%d')
              .sidebar-date-tile-month= l(date.start_date, format: '%b')
            .sidebar-list-item-text
              .sidebar-list-item-title= event.title
              .sidebar-list-item-meta
                = l(date.start_date, format: '%H:%M')
                - if date.location.present?
                  = icon %i[fas fa-location-dot], classes: %w[ms-2 me-1]
                  = date.location

:ruby
  available_products = Queries::Lan::CountRelevantProductInventory.call(lan_party: lan_party)
  sold_tickets = Queries::Lan::CountRelevantTickets.call(lan_party: lan_party)
  if available_products.zero?
    percentage = 0
  else
    percentage = [(sold_tickets / available_products.to_f) * 100.0, 100].min
  end
  sold_out = available_products.positive? && sold_tickets >= available_products

.ticket-progress{ class: ('sold-out' if sold_out) }
  .ticket-progress-label
    %span.ticket-progress-count
      %strong= sold_tickets
      = "/ #{available_products}"
    - if sold_out
      %span.badge.ticket-progress-badge= _('Sidebar|Sold out')
  .progress
    .progress-bar{ class: "progress-bar-#{lan_party.id}", role: 'progressbar', 'aria-valuenow' => sold_tickets, 'aria-valuemin' => 0, 'aria-valuemax' => available_products }

:css
  .progress-bar-#{lan_party.id} {
    width: #{percentage.round(2)}%;
  }

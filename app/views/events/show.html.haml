:ruby
  next_date = model.next_date
  all_dates = model.event_dates.order(:start_date).to_a
  # The next date is shown in the header, so it's not repeated in the list
  upcoming_dates, past_dates = (all_dates - [next_date]).partition { |date| date.end_date.future? }

  # Highlights this event in the sidebar
  provide :current_event_id, model.id.to_s

- provide :page_title, model.title
- content_for :page_title_back_link do
  = link_to events_path, class: 'page-title-back-link' do
    = icon %i[fas fa-arrow-left]
    = _('Event|All events')

.card
  .card-body
    -# There might be no next date if the event is in the past. It should
    -# still be possible to display the event when the direct link is used.
    - if next_date.present?
      .event-key-facts
        = render 'shared/date_tile', date: next_date.start_date, classes: 'date-tile-lg'
        %div
          .event-key-facts-days.with-badge
            = event_date_days(next_date)
            - if (badge = event_date_badge(next_date))
              %span.badge.event-badge= badge
          .event-key-facts-meta
            %span
              = icon %i[far fa-clock]
              = event_date_times(next_date)
            - if next_date.location.present?
              %span
                = icon %i[fas fa-location-dot]
                = next_date.location
    - else
      .event-key-facts
        .text-muted= _('Event|This event is over')

    = markdown(model.description)

  - if upcoming_dates.any? || past_dates.any?
    .card-footer.event-dates
      - if upcoming_dates.any?
        %h2.event-dates-title= _('Event|More dates')
        = render 'events/date_list', dates: upcoming_dates

      - if past_dates.any?
        -# For events that are over, these are the only dates, so they are shown right away
        %details.event-past-dates{ open: next_date.nil? }
          %summary= _('Event|Show past dates (%{count})') % { count: past_dates.count }
          = render 'events/date_list', dates: past_dates.reverse

%ul.event-date-list
  - dates.each do |event_date|
    %li.event-date-row
      = render 'shared/date_tile', date: event_date.start_date
      %div
        .event-date-row-days
          = event_date_days(event_date)
          - if (badge = event_date_badge(event_date))
            %span.badge.event-badge= badge
        .event-date-row-meta
          = event_date_times(event_date)
          - if event_date.location.present?
            %span.ms-2
              = icon %i[fas fa-location-dot]
              = event_date.location

#!/usr/bin/env node

/*
  Converts a .po file to the JSON format used by gettext.js:
  {
    "": {
        "language": "en",
        "plural-forms": "nplurals=2; plural=(n!=1);"
    },
    "simple key": "It's translation",
    "another with %1 parameter": "It's %1 translation",
    "a key with plural": [
        "a plural form",
        "another plural form",
        "could have up to 6 forms with some languages"
    ],
    "a context\u0004a contextualized key": "translation here"
  }

  Usage: bin/po2json input.po output.json [-p]
*/

const fs = require('node:fs');
const { po } = require('gettext-parser');

const [input, output, flag] = process.argv.slice(2);
const pretty = flag === '-p';

if (!input || !output) {
  console.error('Wrong parameters.\nFormat: po2json input.po output.json [OPTIONS]\n-p for pretty');
  process.exit(1);
}

const parsed = po.parse(fs.readFileSync(input), { defaultCharset: 'utf8' });

// gettext-parser keeps the original header case (e.g. "Plural-Forms")
const header = (name) => {
  const key = Object.keys(parsed.headers).find((k) => k.toLowerCase() === name);
  return key && parsed.headers[key];
};

const json = {
  '': {
    'language': header('language'),
    'plural-forms': header('plural-forms')
  }
};

for (const [context, translations] of Object.entries(parsed.translations)) {
  for (const [msgid, t] of Object.entries(translations)) {
    // Skip the header entry and fuzzy translations
    if (msgid === '' && context === '') continue;
    if (t.comments?.flag?.includes('fuzzy')) continue;

    // Do not dump untranslated keys, they already are in the templates!
    if (t.msgstr[0] === '') continue;

    const key = context ? `${context}\u0004${msgid}` : msgid;
    json[key] = t.msgid_plural ? t.msgstr : t.msgstr[0];
  }
}

fs.writeFileSync(output, JSON.stringify(json, null, pretty ? 4 : 0));
console.log(`JSON ${pretty ? 'pretty' : 'compactly'} saved to ${output}`);

- content_for :head do
  %meta{ 'http-equiv' => 'refresh', content: "#{@retry_delay};url=#{@retry_path}" }

- content_for :page_title do
  = _('PayrexxPaymentGateway|Title')

.alert.alert-info
  .d-flex.align-items-center.gap-3
    .spinner-border.spinner-border-sm{ role: 'status' }
    = _('PayrexxPaymentGateway|Your payment is being confirmed, this page refreshes automatically. Please do not pay again.')
